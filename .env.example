# ═══════════════════════════════════════════════════════════════════════════
#  STAR 2.0 — environment template
#  Copy to `.env` and edit.  NEVER commit a real `.env` (it is gitignored).
#  Every variable below has a safe default, so Star runs with an empty env.
#
#  Rule: secrets are only ever READ from the environment. Nothing in the code
#  base stores, logs or echoes a secret value (see Backend/star/security/secrets.py).
# ═══════════════════════════════════════════════════════════════════════════

# ── Gateway (Phase 1) ────────────────────────────────────────────────────────
STAR_GATEWAY_ENABLED=true
STAR_GATEWAY_HOST=0.0.0.0
STAR_GATEWAY_PORT=8765
STAR_GATEWAY_TIMEOUT_S=30
STAR_GATEWAY_MAX_BODY=2097152
STAR_EVENT_BUFFER=500
STAR_CONSOLE_ENABLED=true
STAR_ALLOWED_ORIGINS=*

# Point the *existing* PySide6 HUD at the gateway (empty = mirror disabled).
STAR_GATEWAY_URL=
STAR_GATEWAY_MIRROR=false

# ── Identity / session ───────────────────────────────────────────────────────
STAR_SESSION_ID=star-default
STAR_OWNER=Nilanjan
STAR_LOG_LEVEL=INFO

# ── Paths ────────────────────────────────────────────────────────────────────
# STAR_DATA_DIR=./data
# STAR_WORKSPACE_ROOT=./data/workspace
# STAR_LOGS_DIR=./logs
# STAR_MEMORY_DB=./star_memory.db
# STAR_EPISODES_PATH=./episodes.jsonl
# STAR_PATTERNS_PATH=./data/patterns.jsonl
# STAR_BROWSER_PROFILE_ROOT=./data/workspace/_profiles

# ── Security (Phase 4 · extended in Phase 11) ──────────────────────────────────────────────────────
# ★ dry-run is the development default: computer automation only records actions.
STAR_DRY_RUN=true
STAR_SAFETY_LEVEL=normal            # permissive | normal | strict | paranoid
STAR_CONFIRM_ABOVE_RISK=high        # low | medium | high | critical
STAR_DENY_RISK=critical
STAR_MAX_ACTIONS_SESSION=200
STAR_MAX_ACTIONS_MINUTE=60
STAR_CONFIRMATION_TTL_S=120
STAR_AUDIT_PATH=logs/audit.jsonl
STAR_TOOL_ALLOWLIST=                # comma separated; empty = all registered tools
STAR_TOOL_DENYLIST=
STAR_ALLOW_SHELL=false
STAR_LEGACY_GATE=true             # route the legacy execute_tool() funnel through STAR 2.0 policy
# raw shell execution stays deny-by-default

# ── Browser agent (Phase 5) ──────────────────────────────────────────────────
# Guardrails are paranoid by default: http/https only, public hosts only, no
# window is launched unless a goal asks for it, and every hop is audited.
STAR_BROWSER_ENABLED=true
STAR_BROWSER_SCHEMES=http,https
STAR_BROWSER_PORTS=80,443
STAR_BROWSER_ALLOW_PRIVATE=false    # true = permit localhost / RFC1918 / link-local (dev only)
STAR_BROWSER_RESOLVE_HOSTS=false    # true = DNS-check every resolved IP (SSRF hardening)
STAR_BROWSER_HOST_ALLOWLIST=        # comma separated; empty = any public host
STAR_BROWSER_HOST_DENYLIST=
STAR_BROWSER_TIMEOUT_S=8
STAR_BROWSER_MAX_BYTES=2000000      # hard cap per fetch
STAR_BROWSER_MAX_CHARS=4000         # how much page text the agent keeps
STAR_BROWSER_MAX_STEPS=6            # step budget per browser goal
STAR_BROWSER_STEP_TIMEOUT_S=20
STAR_BROWSER_AUTO_OPEN=false        # true = search/open steps may launch a real window
STAR_BROWSER_USER_AGENT=StarAssistant/2.0 (desktop agent; dry-run by default)

# ── Computer agent (Phase 6) ─────────────────────────────────────────────────
# Screen / mouse / keyboard. Guardrails run *before* the motor and the existing
# six-invariant SafetyGovernor (agent/safety) is reused, not reimplemented.
STAR_COMPUTER_ENABLED=true
STAR_COMPUTER_BACKEND=auto          # auto | null | pyautogui  (auto = pyautogui only when dry-run is off)
STAR_COMPUTER_SCREEN_WIDTH=1920     # the bounds every coordinate is checked against
STAR_COMPUTER_SCREEN_HEIGHT=1080
STAR_COMPUTER_FORBIDDEN_REGIONS=    # "x,y,w,h" comma separated — never click inside these
STAR_COMPUTER_BLOCKED_HOTKEYS=ctrl+alt+del,ctrl+alt+backspace,alt+sysrq
STAR_COMPUTER_MAX_TEXT_CHARS=2000   # refuse oversized typing
STAR_COMPUTER_MAX_SCROLL=20         # clicks of scroll wheel per action
STAR_COMPUTER_MAX_WAIT_S=30         # longest single wait
STAR_COMPUTER_MAX_STEPS=8           # step budget per computer goal
STAR_COMPUTER_STEP_TIMEOUT_S=20
STAR_COMPUTER_VERIFY_DELAY_S=0.4    # OBSERVE→ACT→VERIFY pause before re-capturing
STAR_COMPUTER_CHANGE_THRESHOLD=0.02 # fraction of pixels that must change to count as verified

# ── Voice (Phase 2) ──────────────────────────────────────────────────────────
STAR_STT_PROVIDER=auto              # auto | google_dual | whisper | browser | file | null
STAR_TTS_PROVIDER=auto              # auto | edge | null
STAR_TTS_VOICE=bn-IN-BashkarNeural  # bn-IN-TanishaaNeural / bn-BD-PradeepNeural / en-IN-*
STAR_TTS_RATE=+0%
STAR_TTS_PITCH=+0Hz
STAR_TTS_VOLUME=+50%
STAR_LANGUAGES=bn,en
STAR_RESPONSE_LANGUAGE=bn
STAR_VOICE_KEEP_TRANSCRIPTS=false   # privacy: drop transcripts unless explicitly enabled
STAR_VOICE_BARGE_IN=true
STAR_VOICE_AUTO_SPEAK=false   # true = the gateway synthesises audio for every reply
STAR_VOICE_SPEAKER_VERIFY=false
STAR_VOICE_MAX_UTTERANCE_S=12


# ── Brain (Phase 3) ──────────────────────────────────────────────────────────
STAR_LLM_MODE=auto                  # auto | local | gemini | offline | null
STAR_LOCAL_LLM_URL=http://localhost:11434/v1
STAR_LOCAL_LLM_MODEL=star-local:latest
STAR_GEMINI_MODEL=gemini-2.5-flash
STAR_MAX_PLAN_TASKS=8
STAR_MAX_TOOL_CALLS=12
STAR_REFLECTION=true
STAR_PREDICTION=true
STAR_RETRIEVAL_TOP_K=5
STAR_REASONING_CHAIN=router,provider,fallback   # order of reasoning stages
STAR_LLM_TIMEOUT_S=25                 # bound on any LLM call
STAR_ROUTER_TIMEOUT_S=20              # bound on the deterministic router

# ── Workspace (Phase 7) ──────────────────────────────────────────────────────
# The invisible background workspace: every session gets a JAILED directory under
# STAR_WORKSPACE_ROOT. The jail is always enforced — no setting can weaken it.
STAR_WORKSPACE_ENABLED=true
STAR_WORKSPACE_MAX_SESSIONS=4
STAR_WORKSPACE_TTL_S=3600
STAR_ISOLATION_BACKEND=null         # null | process | windows_virtual_desktop (not wired yet ⇒ falls back)
STAR_WORKSPACE_CHECKPOINTS=true
STAR_WORKSPACE_MAX_CHECKPOINTS=5    # snapshots kept per session
STAR_WORKSPACE_MAX_FILES=500        # per-session file quota
STAR_WORKSPACE_MAX_BYTES=50000000   # per-session byte quota
STAR_WORKSPACE_MAX_WRITE_BYTES=2000000   # cap on one write
STAR_WORKSPACE_CHECKPOINT_MAX_BYTES=10000000
STAR_WORKSPACE_ALLOW_SPAWN=false    # opt-in only: let a session start its own OS process

# ── Memory (Phase 8) ─────────────────────────────────────────────────────────
# Layered memory: working / episodic / semantic / preferences / procedural patterns.
# There is NO second store here — these settings shape retrieval over the stores Star
# already had (agent.memory.store.MemoryStore SQLite, agent.planning.memory.EpisodicMemory
# JSONL, the brain's PatternStore JSONL and the brain's per-session scratch buffer).
# STAR_MEMORY_ENABLED=false turns the layered manager off (retrieval and writes are
# refused honestly); it never deletes anything that is already stored.
STAR_MEMORY_ENABLED=true
STAR_MEMORY_WORKING_SESSIONS=32     # how many sessions keep working-memory scratch
STAR_MEMORY_WORKING_TURNS=8         # turns kept per session
STAR_MEMORY_RETRIEVAL_LIMIT=8       # blended hits handed to the brain before it plans
STAR_MEMORY_PER_LAYER=5             # candidates gathered from each layer
STAR_MEMORY_EPISODE_RECALL=5        # similar past interactions recalled
STAR_MEMORY_RECENT_SCAN=300         # window used for layer counts / preference listing
STAR_MEMORY_TIMEOUT_S=4.0           # bound on every blocking store call (never hangs a reply)
# Layer weights — the only place one layer may outrank another (0..1, visible in /api/v1/memory)
STAR_MEMORY_WEIGHT_WORKING=1.0
STAR_MEMORY_WEIGHT_PREFERENCE=0.95
STAR_MEMORY_WEIGHT_EPISODIC=0.85
STAR_MEMORY_WEIGHT_SEMANTIC=0.8
STAR_MEMORY_WEIGHT_PATTERN=0.6
STAR_EPISODES_PATH=                 # optional: where the JSONL episode log lives

# ── Learning (Phase 9) ───────────────────────────────────────────────────────
# The safe learning loop: interaction → observation → feedback → candidate →
# validation → memory update → future retrieval. It owns NO long-term store — it
# keeps a candidate ledger + feedback log (staging, under data/learning/) and
# promotes only gate-cleared candidates into the brain's PatternStore (procedural)
# and the shared MemoryStore (preferences). It can never write executable code or
# model weights (blueprint §9: "no uncontrolled self-modification").
# STAR_LEARNING_ENABLED=false stops all observation/validation/promotion and touches no disk.
STAR_LEARNING_ENABLED=true
STAR_LEARNING_AUTO_PROMOTE=true     # promote validated candidates without being asked
STAR_LEARNING_MIN_FREQUENCY=3       # sightings before a pattern is even a candidate
STAR_LEARNING_MIN_SUCCESS_RATE=0.8  # successes / (successes + failures) required to learn
STAR_LEARNING_MAX_RISK=medium       # never learn a pattern whose tools exceed this tier
STAR_LEARNING_MAX_CANDIDATES=500    # bound on the working set (oldest terminal evicted)
STAR_LEARNING_MAX_PROMOTIONS=8      # cap on promotions per validation sweep
STAR_LEARNING_REQUIRE_APPROVAL=true # a preference needs explicit positive feedback to promote
STAR_LEARNING_TIMEOUT_S=4.0
# STAR_CANDIDATES_PATH=             # optional: where the candidate ledger JSONL lives
# STAR_FEEDBACK_PATH=               # optional: where the feedback log JSONL lives

# ── Orchestrator (Phase 10) ──────────────────────────────────────────────────
# Coordinates complex multi-step and multi-agent operations with stateful tracking,
# checkpoint persistence, pause/resume, and honest bounded recovery.
STAR_ORCHESTRATOR_ENABLED=true
STAR_ORCHESTRATOR_MAX_PARALLEL=4
STAR_ORCHESTRATOR_MAX_RETRIES=2
STAR_ORCHESTRATOR_TASK_TIMEOUT_S=30.0
STAR_ORCHESTRATOR_PLAN_TIMEOUT_S=120.0
STAR_ORCHESTRATOR_CHECKPOINTS=true
STAR_ORCHESTRATOR_MAX_CHECKPOINTS=20
STAR_ORCHESTRATOR_ALLOW_PARALLEL_AGENTS=true
# STAR_CHECKPOINTS_PATH=./data/orchestrator/checkpoints.jsonl

# ── Secrets (existing Star variables — keep them out of the repo) ─────────────
GEMINI_API_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
